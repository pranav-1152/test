<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Consultant</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ANIMATION STYLES -->
    <style>
        /* Scroll Animations */
        .fade-left {
            opacity: 0;
            transform: translateX(-50px);
            transition: all 0.8s ease;
        }

        .fade-right {
            opacity: 0;
            transform: translateX(50px);
            transition: all 0.8s ease;
        }

        .show {
            opacity: 1;
            transform: translateX(0);
        }

        /* Card Hover Effect */
        .hover-box {
            transition: 0.3s ease;
        }

        .hover-box:hover {
            transform: translateY(-10px);
            box-shadow: 0px 15px 30px rgba(0, 0, 0, 0.15);
        }

        /* Heading Underline Animation */
        .title-line {
            position: relative;
            display: inline-block;
        }

        .title-line::after {
            content: '';
            width: 0;
            height: 3px;
            background: #28a745;
            position: absolute;
            left: 0;
            bottom: -6px;
            transition: 0.4s ease;
        }

        .title-line:hover::after {
            width: 100%;
        }

        /* Feature List Animation */
        .feature-list li {
            opacity: 0;
            transform: translateX(-20px);
            animation: listFade 0.6s ease forwards;
        }

        .feature-list li:nth-child(1) {
            animation-delay: 0.2s;
        }

        .feature-list li:nth-child(2) {
            animation-delay: 0.4s;
        }

        .feature-list li:nth-child(3) {
            animation-delay: 0.6s;
        }

        .feature-list li:nth-child(4) {
            animation-delay: 0.8s;
        }

        .feature-list li:nth-child(5) {
            animation-delay: 1s;
        }

        @keyframes listFade {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ============================= */
        /* GLOBAL UI IMPROVEMENTS */
        /* ============================= */

        body {
            background: #eef2f6;
        }

        /* Navbar Shadow */
        .navbar {
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        }

        /* Section Spacing Smooth Look */
        section {
            position: relative;
            overflow: hidden;
        }

        /* ============================= */
        /* HERO SECTION PROFESSIONAL EFFECT */
        /* ============================= */

        /* Makes hero feel premium */
        section:first-of-type {
            background-attachment: fixed;
        }

        /* Dark overlay glow */
        section:first-of-type::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.7));
            z-index: 0;
        }

        section:first-of-type>div {
            position: relative;
            z-index: 2;
        }

        /* Hero Glass Effect */
        section:first-of-type div {
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* ============================= */
        /* CARD UI PROFESSIONAL LOOK */
        /* ============================= */

        .card-hover,
        .hover-box {
            border: 1px solid rgba(0, 0, 0, 0.05);
            background: linear-gradient(180deg, #ffffff, #fafafa);
        }

        /* Smooth hover glow */
        .card-hover:hover,
        .hover-box:hover {
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
        }

        /* ============================= */
        /* SECTION BACKGROUND TEXTURE */
        /* ============================= */

        /* HOW IT WORKS */
        section:nth-of-type(2) {
            background: linear-gradient(180deg, #ffffff, #f1f4f8);
        }

        /* SERVICES */
        section:nth-of-type(3) {
            background: linear-gradient(180deg, #f8f9fa, #edf2f7);
        }

        /* ABOUT SECTION */
        section:nth-of-type(4) {
            background: linear-gradient(180deg, #f8f9fa, #ffffff);
        }

        /* CTA SECTION */
        section:last-of-type {
            background: linear-gradient(135deg, #000000, #1a1a1a);
        }

        /* ============================= */
        /* BUTTON PROFESSIONAL EFFECT */
        /* ============================= */

        button {
            transition: all 0.3s ease;
        }

        button:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(40, 167, 69, 0.5);
        }

        /* ============================= */
        /* TEXT POLISH */
        /* ============================= */

        h1,
        h2,
        h3,
        h4,
        h5 {
            letter-spacing: 0.3px;
        }

        p {
            font-size: 16px;
        }

        /* ============================= */
        /* SOFT SECTION DIVIDER EFFECT */
        /* ============================= */

        section::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.1), transparent);
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center" href="/">
                Digital Consultant
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link active" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/about">About Us</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            Account
                        </a>

                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item action" href="/admin-login">Admin</a></li>
                            <li><a class="dropdown-item" href="#">User</a></li>
                        </ul>
                    </li>

                </ul>

                <form class="d-flex">
                    <input class="form-control me-2" type="search" placeholder="Search">
                    <button class="btn btn-outline-success">Search</button>
                </form>

            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section style="background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), 
        url('/image/photo-1542838132-92c53300491e.jpg'); 
        background-size: cover; 
        background-position: center; 
        background-repeat: no-repeat; 
        height: 92vh; 
        width: 100%; 
        display: flex;
        justify-content: center;
        align-items: center;">

        <div style="background: rgba(0,0,0,0.65); padding: 40px; border-radius: 12px; max-width: 1000px;">

            <h1 style="color: white; font-size: 46px; margin-bottom: 15px; font-weight: bold;">
                Start Your Agro Business With Expert DPR Support
            </h1>

            <h3 style="color: #f1f1f1; font-size: 22px; margin-bottom: 15px;">
                Complete Digital Consulting for Fruit & Vegetable Processing Business
            </h3>

            <p style="color: #dddddd; font-size: 16px; line-height: 1.6; margin-bottom: 20px;">
                Our digital consulting platform helps entrepreneurs prepare detailed DPR (Detailed Project Report)
                for fruit and vegetable product businesses. We guide you with market analysis, investment planning,
                raw material sourcing, production process guidance, government subsidy information
                to successfully start your business.
            </p>

        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section style="padding:80px 20px;background:white;">

        <div class="fade-up" style="max-width:1100px;margin:auto;text-align:center;">

            <h2 class="title-line">How Our Platform Works</h2>
            <p style="margin-top:15px;color:#555;">
                Our simple 4 step process helps entrepreneurs convert business ideas into successful agro processing
                ventures.
            </p>

            <div style="display:flex;flex-wrap:wrap;gap:20px;justify-content:center;margin-top:30px;">

                <div class="card-hover" style="width:260px;padding:20px;border-radius:12px;background:#f8f9fa;">
                    <h4>Idea Submission</h4>
                    <p>Submit product details, investment capacity and business location for feasibility analysis.</p>
                </div>

                <div class="card-hover" style="width:260px;padding:20px;border-radius:12px;background:#f8f9fa;">
                    <h4>Market Analysis</h4>
                    <p>We analyze demand, raw material availability, competition and profit potential.</p>
                </div>

                <div class="card-hover" style="width:260px;padding:20px;border-radius:12px;background:#f8f9fa;">
                    <h4>DPR Preparation</h4>
                    <p>Our system generates professional DPR including cost, machinery, ROI and production planning.</p>
                </div>

                <div class="card-hover" style="width:260px;padding:20px;border-radius:12px;background:#f8f9fa;">
                    <h4>Business Launch</h4>
                    <p>Download DPR and apply for subsidy, MSME registration and bank loan.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- SERVICES -->
    <section style="padding:80px 20px;background:#f8f9fa;">

        <div class="fade-up" style="max-width:1100px;margin:auto;text-align:center;">

            <h2 class="title-line">Our Consulting Services</h2>
            <p style="color:#555;margin-top:10px;">
                We provide end-to-end consulting support for agro processing entrepreneurs.
            </p>

            <div
                style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:30px;">

                <div class="card-hover" style="background:white;padding:20px;border-radius:12px;">
                    <h5>DPR Generation</h5>
                    <p>Bank loan ready professional project reports with financial projections.</p>
                </div>

                <div class="card-hover" style="background:white;padding:20px;border-radius:12px;">
                    <h5>Profit Planning</h5>
                    <p>Investment planning, monthly income estimation and ROI calculation.</p>
                </div>

                <div class="card-hover" style="background:white;padding:20px;border-radius:12px;">
                    <h5>Machinery Guidance</h5>
                    <p>Production machinery selection and setup guidance.</p>
                </div>

                <div class="card-hover" style="background:white;padding:20px;border-radius:12px;">
                    <h5>Subsidy Assistance</h5>
                    <p>Government schemes, MSME and food processing subsidy support.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section style="padding: 80px 20px; background-color: #f8f9fa; width: 100%;">

        <div
            style="max-width: 1100px; margin: auto; text-align: centercenter; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;">

            <!-- Left Content -->
            <div class="fade-left" style="flex: 1; min-width: 300px; padding: 20px;">

                <h2 class="title-line" style="font-size: 36px; color: #2d3436; margin-bottom: 15px;">
                    About Our Digital Consultant Platform
                </h2>

                <p style="font-size: 16px; color: #555; line-height: 1.7; margin-bottom: 15px;">
                    We are a digital consulting platform that helps people start profitable fruit and vegetable
                    processing businesses. Our website provides complete support from idea validation to business
                    planning by generating professional DPR (Detailed Project Reports).
                </p>

                <p style="font-size: 16px; color: #555; line-height: 1.7; margin-bottom: 20px;">
                    We guide entrepreneurs with step-by-step business setup information including raw material
                    sourcing, required machinery, production process, cost estimation, profit calculation,
                    government schemes, subsidies, and market strategies.
                </p>

                <ul class="feature-list" style="padding-left: 18px; color: #333; line-height: 1.8;">
                    <li>DPR Creation for Agro Processing Businesses</li>
                    <li>Investment & Profit Planning</li>
                    <li>Machinery & Infrastructure Guidance</li>
                    <li>Government Subsidy & MSME Support</li>
                    <li>Market Research & Product Demand Analysis</li>
                </ul>

            </div>

            <!-- Right Side Box -->
            <div class="fade-right" style="flex: 1; min-width: 300px; padding: 20px;">

                <div class="hover-box"
                    style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0px 5px 15px rgba(0,0,0,0.1);">

                    <h3 style="font-size: 26px; color: #28a745; margin-bottom: 10px;">
                        Why Choose Us?
                    </h3>

                    <p style="font-size: 15px; color: #555; line-height: 1.6;">
                        Our platform simplifies complex business planning and provides accurate, practical,
                        and easy-to-understand reports. We focus on helping small entrepreneurs, farmers,
                        and startups turn their business ideas into successful ventures.
                    </p>

                </div>

            </div>

        </div>

    </section>

    <section style="padding:70px 20px;background:black;color:white;text-align:center;">

        <h2 style="font-size:36px;margin-bottom:15px;">
            Start Your Agro Business Today
        </h2>

        <p>
            Generate professional DPR and turn your idea into reality.
        </p>

        <button style="padding:12px 30px;background:#28a745;border:none;border-radius:6px;color:white;">
            Get Started Now
        </button>

    </section>

    <!-- SCROLL SCRIPT -->
    <script>
        const elements = document.querySelectorAll('.fade-left, .fade-right');

        window.addEventListener('scroll', () => {
            elements.forEach(el => {
                const position = el.getBoundingClientRect().top;
                const screenHeight = window.innerHeight;

                if (position < screenHeight - 100) {
                    el.classList.add('show');
                }
            });
        });
    </script>

</body>

</html>
