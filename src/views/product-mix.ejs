<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="/css/.css">
</head>
<style>
    :root {
        --primary: #2563eb;
        --primary-dark: #1e40af;
        --bg: #f1f5f9;
        --card: #ffffff;
        --border: #e5e7eb;
        --text: #1f2937;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 15px;
        font-family: "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    h1 {
        font-size: 28px;
        margin: 20px;
        text-align: center;
        color: var(--primary-dark);
    }

    h2 {
        font-size: 20px;
        margin-bottom: 15px;
        color: var(--primary);
    }

    .container {
        background: var(--card);
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        margin-bottom: 30px;
    }

    /* ---------- TABLE ---------- */
    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 12px;
        overflow: hidden;
    }

    thead th {
        background: var(--primary);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 12px;
        text-align: center;
    }

    tbody td {
        border-bottom: 1px solid var(--border);
        padding: 10px;
        font-size: 14px;
        text-align: center;
    }

    tbody tr:hover {
        background: #f8fafc;
    }

    /* ---------- INPUTS ---------- */
    input[type="number"],
    input[type="text"] {
        width: 100%;
        padding: 7px 8px;
        border-radius: 6px;
        border: 1px solid var(--border);
        font-size: 13px;
    }

    input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
    }

    .readonly {
        background: #f3f4f6;
        border: none;
        font-weight: 600;
    }

    /* ---------- BUTTONS ---------- */
    .btn {
        padding: 7px 14px;
        border-radius: 6px;
        border: none;
        font-size: 13px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-add {
        background: #16a34a;
        color: #ffffff;
    }

    .btn-delete {
        background: #dc2626;
        color: #ffffff;
    }

    /* ---------- TOTAL BOX ---------- */
    .total-box {
        margin-top: 18px;
        padding: 18px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e0e7ff, #f8fafc);
        font-size: 17px;
        font-weight: 600;
        text-align: right;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.05);
    }

    .total-box strong {
        color: var(--primary-dark);
        font-size: 18px;
    }

    @media (max-width: 768px) {
        body {
            padding: 15px;
        }
    }

    .product-form {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        width: 180px;
    }

    .form-group label {
        font-weight: 600;
        margin-bottom: 6px;
        font-size: 14px;
    }

    .form-group input {
        padding: 8px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .submit-btn {
        align-self: flex-end;
        height: 38px;
        padding: 0 18px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

<h2>PRODUCT MIX CALCULATION</h2>

<table class="main-table">

  <tr class="table-header">
    <th>Sr No</th>
    <th>Assumptions for Product Mix</th>
    <th>Production in Days</th>
    <th>Raw Material 100% Capacity</th>
    <th>Raw Material Cost (Cr)</th>
    <th>Selling Price (Cr)</th>
    <th>Total Production/year</th>
    <th>Total RM input/year</th>
  </tr>

  <!-- FRUITS -->
  <tr class="category-row">
    <td></td>
    <td>FRUITS</td>
    <td colspan="6"></td>
  </tr>

  <tr>
    <td>1</td>
    <td>Mango</td>
    <td><input type="number" name="mangoDays"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

  <tr>
    <td>2</td>
    <td>Jack Fruit</td>
    <td><input type="number" name="jackfruitDays"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

  <tr>
    <td>3</td>
    <td>Pineapple</td>
    <td><input type="number" name="pineappleDays"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

  <!-- VEGETABLES -->
  <tr class="category-row">
    <td></td>
    <td>VEGETABLES</td>
    <td colspan="6"></td>
  </tr>

  <tr>
    <td>6</td>
    <td>Okra</td>
    <td><input type="number"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

  <!-- ROOT CROPS -->
  <tr class="category-row">
    <td></td>
    <td>ROOT CROPS</td>
    <td colspan="6"></td>
  </tr>

  <tr>
    <td>14</td>
    <td>Sweet Potato</td>
    <td><input type="number"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

  <!-- DRY FRUITS -->
  <tr class="category-row">
    <td></td>
    <td>DRY FRUITS</td>
    <td colspan="6"></td>
  </tr>

  <tr>
    <td>19</td>
    <td>Cashew</td>
    <td><input type="number"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
    <td class="readonly"></td>
  </tr>

</table>

<br>

<button class="btn-primary">Calculate Product Mix</button>

<h2>Product Mix Calculation</h2>

<form action="/product-mix/save" method="POST">

  <div class="form-row">

    <div class="form-group">
      <label>Product Name</label>
      <input name="productName" required>
    </div>

    <div class="form-group">
      <label>Production Days</label>
      <input name="productionDays" type="number" required>
    </div>

    <div class="form-group">
      <label>Raw Material Capacity %</label>
      <input name="capacity" type="number" required>
    </div>

    <div class="form-group">
      <label>RM Cost (Cr)</label>
      <input name="rmCost" type="number" required>
    </div>

    <div class="form-group">
      <label>Selling Price (Cr)</label>
      <input name="selling" type="number" required>
    </div>

  </div>

  <br>
  <button type="submit">Save Product Mix</button>

</form>

</body>

</html>