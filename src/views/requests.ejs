<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>All Requests</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
    }

    /* Top Bar */
    .topbar {
      background: #ffffff;
      height: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 30px;
      border-bottom: 1px solid #ddd;
    }

    /* Layout */
    .container {
      display: flex;
    }

    /* Sidebar */
    .sidebar {
      width: 220px;
      background: #ffffff;
      min-height: calc(100vh - 60px);
      border-right: 1px solid #ddd;
      padding-top: 20px;
    }

    .sidebar a {
      display: block;
      padding: 12px 30px;
      color: #555;
      text-decoration: none;
      font-size: 14px;
    }

    .sidebar a:hover {
      background: #f0f0f0;
    }

    /* Main */
    .main {
      flex: 1;
      padding: 30px;
    }

    /* Card */
    .card {
      background: #ffffff;
      border-radius: 12px;
      padding: 20px;
    }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th,
    td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #eee;
      font-size: 14px;
    }

    th {
      background: #f8f8f8;
    }

    /* Status Badges */
    .status {
      padding: 6px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: bold;
    }

    .pending {
      background: #fff1d6;
      color: #a36a00;
    }

    .approved {
      background: #e6fff3;
      color: #007a4d;
    }

    .generated {
      background: #e8f0ff;
      color: #1e40af;
    }

    .rejected {
      background: #ffecec;
      color: #b00020;
    }

    /* Action Button */
    button {
      padding: 6px 10px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      background: #1e90ff;
      color: white;
    }

    button:hover {
      background: #1c7ed6;
    }
  </style>
</head>

<body>

  <!-- Top Bar -->
  <div class="topbar">
    <strong>Admin Logo</strong>
    <span>🔔 Admin</span>
  </div>

  <div class="container">

    <!-- Sidebar -->
    <div class="sidebar">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/requests"><strong>Requests</strong></a>
      <a href="#">Pending DPR</a>
      <a href="#">Generated DPR</a>
      <a href="#">Rejected</a>
      <a href="#">Reports</a>
      <a href="#">Settings</a>
    </div>

    <!-- Main -->
    <div class="main">

      <div class="card">
        <h2>All Requests</h2>
<form method="GET" action="/admin/requests"
      style="display:flex;gap:10px;align-items:center;margin-bottom:15px;">

  <input type="text"
         name="search"
         placeholder="Search company / product"
         value="<%= search || '' %>"
         style="padding:6px 10px;width:220px;">

  <select name="status" style="padding:6px 10px;">
    <option value="">All Status</option>
    <option value="pending" <%= status==='pending'?'selected':'' %>>Pending</option>
    <option value="approved" <%= status==='approved'?'selected':'' %>>Approved</option>
    <option value="rejected" <%= status==='rejected'?'selected':'' %>>Rejected</option>
    <option value="generated" <%= status==='generated'?'selected':'' %>>Generated</option>
  </select>

  <button type="submit">Apply</button>
</form>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Company Name</th>
              <th>Project</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach((req, index)=> { %>
              <tr>
                <td>
                  <%= index + 1 %>
                </td>
                <td>
                  <%= req.companyName %>
                </td>
                <td>
                  <%= req.productManufactured %>
                </td>
                <td>
                  <span class="status <%= req.status %>">
                    <%= (req.status || "pending" ).toUpperCase() %>
                  </span>
                </td>
                <td>
                  <button class="view-btn" data-id="<%= req._id %>">View</button>
                </td>
              </tr>
              <% }) %>
          </tbody>

        </table>

        <div style="margin-top:20px;display:flex;justify-content:center;gap:6px;">

  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>">
      <button>Prev</button>
    </a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?page=<%= i %>&search=<%= search %>&status=<%= status %>">
      <button style="<%= i === currentPage ? 'background:#000;' : '' %>">
        <%= i %>
      </button>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>">
      <button>Next</button>
    </a>
  <% } %>

</div>
      </div>

    </div>

  </div>

  <!-- VIEW REQUEST MODAL -->
  <div id="requestModal" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.5);
    justify-content:center;
    align-items:center;
  ">

    <div style="
      background:#fff;
      width:70%;
      max-height:80%;
      overflow:auto;
      border-radius:12px;
      padding:20px;
    ">
      <h2 id="modalTitle"></h2>

      <div id="modalBody"></div>

      <div style="margin-top:20px;display:flex;justify-content:flex-end;gap:10px;">
        <button id="approveBtn" onclick="approveRequest()">Approve</button>
        <button id="rejectBtn" onclick="rejectRequest()" style="background:#ef4444;">Reject</button>
        <button id="deleteBtn" onclick="deleteRequest()" style="background:#000;">Delete</button>
        <button id="generateBtn" onclick="generateDPR()" style="background:#10b981;display:none;"> Generate DPR
        </button>
        <button onclick="closeModal()">Close</button>
      </div>

    </div>
  </div>

  
  <script>
    // ===== DATA =====
    const requests = <%- JSON.stringify(requests) %>;
    let selectedRequest = null;

    // ===== DOM CACHE =====
    const modal = document.getElementById("requestModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalBody = document.getElementById("modalBody");

    const approveBtn = document.getElementById("approveBtn");
    const rejectBtn = document.getElementById("rejectBtn");
    const deleteBtn = document.getElementById("deleteBtn");
    const generateBtn = document.getElementById("generateBtn");

    // ===== EVENT DELEGATION FOR VIEW BUTTON =====
    document.addEventListener("click", (e) => {
      const btn = e.target.closest(".view-btn");
      if (!btn) return;

      const id = btn.dataset.id;
      openRequestModal(id);
    });

    // ===== OPEN MODAL =====
    function openRequestModal(id) {
      selectedRequest = requests.find(r => String(r._id) === String(id));

      if (!selectedRequest) {
        alert("Request not found");
        return;
      }

      modalTitle.textContent = selectedRequest.companyName || "";
      modalBody.innerHTML = "";

      Object.entries(selectedRequest).forEach(([key, value]) => {
        if (key === "_id" || key === "__v") return;

        const row = document.createElement("div");
        row.style.display = "flex";
        row.style.borderBottom = "1px solid #eee";
        row.style.padding = "6px 0";

        row.innerHTML = `
        <div style="width:40%;font-weight:bold;">
          ${key.replace(/([A-Z])/g, " $1")}
        </div>
        <div style="width:60%;">
          ${value ?? "-"}
        </div>
      `;

        modalBody.appendChild(row);
      });

      toggleButtons();
      modal.style.display = "flex";
    }

    // ===== BUTTON VISIBILITY =====
    function toggleButtons() {
      approveBtn.style.display =
        selectedRequest.status === "pending" ? "inline-block" : "none";

      rejectBtn.style.display =
        selectedRequest.status === "pending" ? "inline-block" : "none";

      generateBtn.style.display =
        selectedRequest.status === "approved" ? "inline-block" : "none";

      deleteBtn.style.display =
        selectedRequest.status !== "generated" ? "inline-block" : "none";
    }

    // ===== CLOSE MODAL =====
    function closeModal() {
      modal.style.display = "none";
    }

    // ===== API ACTIONS =====
    async function postAction(url) {
      const res = await fetch(url, { method: "POST" });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || "Action failed");
    }

    async function approveRequest() {
      try {
        await postAction(`/admin/requests/${selectedRequest._id}/approve`);
        alert("Request approved");
        location.reload();
      } catch (e) {
        alert(e.message);
      }
    }

    async function rejectRequest() {
      try {
        await postAction(`/admin/requests/${selectedRequest._id}/reject`);
        alert("Request rejected");
        location.reload();
      } catch (e) {
        alert(e.message);
      }
    }

    async function deleteRequest() {
      if (!confirm("Delete this request permanently?")) return;

      try {
        const res = await fetch(`/admin/requests/${selectedRequest._id}`, {
          method: "DELETE"
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.message || "Delete failed");

        alert("Request deleted");
        location.reload();
      } catch (e) {
        alert(e.message);
      }
    }

    // ===== BUTTON EVENTS =====
    approveBtn.addEventListener("click", approveRequest);
    rejectBtn.addEventListener("click", rejectRequest);
    deleteBtn.addEventListener("click", deleteRequest);
    document.querySelector("#requestModal button:last-child")
      .addEventListener("click", closeModal);

    console.log("Requests loaded:", requests.length);
  </script>


</body>

</html>