<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>All Requests</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
    }

    .topbar {
      background: #ffffff;
      height: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 30px;
      border-bottom: 1px solid #ddd;
    }

    .container {
      display: flex;
    }

    .sidebar {
      width: 220px;
      background: #ffffff;
      min-height: calc(100vh - 60px);
      border-right: 1px solid #ddd;
      padding-top: 20px;
    }

    .sidebar a {
      display: block;
      padding: 12px 30px;
      color: #555;
      text-decoration: none;
      font-size: 14px;
    }

    .sidebar a:hover {
      background: #f0f0f0;
    }

    .main {
      flex: 1;
      padding: 30px;
    }

    .card {
      background: #ffffff;
      border-radius: 12px;
      padding: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th,
    td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #eee;
      font-size: 14px;
    }

    th {
      background: #f8f8f8;
    }

    .status {
      padding: 6px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: bold;
    }

    .pending {
      background: #fff1d6;
      color: #a36a00;
    }

    .approved {
      background: #e6fff3;
      color: #007a4d;
    }

    .generated {
      background: #e8f0ff;
      color: #1e40af;
    }

    .rejected {
      background: #ffecec;
      color: #b00020;
    }

    button {
      padding: 6px 10px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      background: #1e90ff;
      color: white;
    }

    button:hover {
      background: #1c7ed6;
    }
  </style>
</head>

<body>

  <!-- TOP BAR -->
  <div class="topbar">
    <strong>Admin Panel</strong>
    <span>🔔 Admin</span>
  </div>

  <div class="container">

    <!-- SIDEBAR -->
    <div class="sidebar">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/requests"><strong>Requests</strong></a>
      <a href="#">Reports</a>
      <a href="#">Settings</a>
    </div>

    <!-- MAIN -->
    <div class="main">

      <div class="card">
        <h2>All Requests</h2>

        <!-- SEARCH FILTER -->
        <form method="GET" action="/admin/requests"
          style="display:flex;gap:10px;align-items:center;margin-bottom:15px;">

          <input type="text" name="search" placeholder="Search company" value="<%= search || '' %>"
            style="padding:6px 10px;width:220px;">

          <select name="status" style="padding:6px 10px;">
            <option value="">All Status</option>
            <option value="pending" <%=status==='pending' ?'selected':'' %>>Pending</option>
            <option value="approved" <%=status==='approved' ?'selected':'' %>>Approved</option>
            <option value="rejected" <%=status==='rejected' ?'selected':'' %>>Rejected</option>
            <option value="generated" <%=status==='generated' ?'selected':'' %>>Generated</option>
          </select>

          <button type="submit">Apply</button>
        </form>

        <!-- TABLE -->
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Company</th>
              <th>Product</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% (requests || []).forEach((req, index)=> { %>
              <tr>
                <td>
                  <%= index + 1 %>
                </td>
                <td>
                  <%= req.companyName %>
                </td>
                <td>
                  <%= req.productManufactured %>
                </td>
                <td>
                  <span class="status <%= req.status || 'pending' %>">
                    <%= (req.status || "pending" ).toUpperCase() %>
                  </span>
                </td>
                <td>
                  <button class="view-btn" data-id="<%= req._id %>">View</button>
                </td>
              </tr>
              <% }) %>
          </tbody>

        </table>

        <!-- PAGINATION -->
        <% if (typeof totalPages !=="undefined" ) { %>
          <div style="margin-top:20px;display:flex;justify-content:center;gap:6px;">

            <% if (currentPage> 1) { %>
              <a href="?page=<%= currentPage - 1 %>">
                <button>Prev</button>
              </a>
              <% } %>

                <% for (let i=1; i <=totalPages; i++) { %>
                  <a href="?page=<%= i %>">
                    <button style="<%= i === currentPage ? 'background:black;' : '' %>">
                      <%= i %>
                    </button>
                  </a>
                  <% } %>

                    <% if (currentPage < totalPages) { %>
                      <a href="?page=<%= currentPage + 1 %>">
                        <button>Next</button>
                      </a>
                      <% } %>

          </div>
          <% } %>

      </div>

    </div>
  </div>

  <!-- MODAL -->
  <div id="requestModal" style="
    display:none;
    position:fixed;
    top:0;left:0;
    width:100%;height:100%;
    background:rgba(0,0,0,0.5);
    justify-content:center;
    align-items:center;">

    <div style="background:white;width:70%;max-height:80%;overflow:auto;padding:20px;border-radius:12px;">

      <h3 id="modalTitle"></h3>
      <div id="modalBody"></div>

      <div style="margin-top:15px;text-align:right;">
        <button id="approveBtn">Approve</button>
        <button id="rejectBtn" style="background:red;">Reject</button>
        <button id="deleteBtn" style="background:black;">Delete</button>
        <button onclick="closeModal()">Close</button>
      </div>

    </div>
  </div>

  <!-- SCRIPT -->
  <script>

    const requests = <% - JSON.stringify(requests || []) %>;
    let selectedRequest = null;

    const modal = document.getElementById("requestModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalBody = document.getElementById("modalBody");

    document.addEventListener("click", e => {
      const btn = e.target.closest(".view-btn");
      if (!btn) return;

      const id = btn.dataset.id;
      selectedRequest = requests.find(r => r._id === id);

      if (!selectedRequest) return;

      modalTitle.innerText = selectedRequest.companyName;
      modalBody.innerHTML = "";

      Object.entries(selectedRequest).forEach(([key, val]) => {
        if (key === "_id" || key === "__v") return;

        modalBody.innerHTML += `
          <p><b>${key}</b> : ${val ?? "-"}</p>
        `;
      });

      modal.style.display = "flex";
    });

    function closeModal() {
      modal.style.display = "none";
    }

  </script>

</body>

</html>