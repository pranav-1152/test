  <script >
  const requests = <%- JSON.stringify(requests) %>;
  let selectedRequest = null;

  function viewRequest(id) {
    selectedRequest = requests.find(r => r._id === id);

    document.getElementById("modalTitle").innerText =
      selectedRequest.companyName;

    const modalBody = document.getElementById("modalBody");
    modalBody.innerHTML = "";

    Object.entries(selectedRequest).forEach(([key, value]) => {
      if (key === "_id" || key === "__v") return;

      const row = document.createElement("div");
      row.style.display = "flex";
      row.style.borderBottom = "1px solid #eee";
      row.style.padding = "6px 0";

      row.innerHTML = `
        <div style="width:40%;font-weight:bold;">
          ${key.replace(/([A-Z])/g, ' $1')}
        </div>
        <div style="width:60%;">
          ${value ?? "-"}
        </div>
      `;

      modalBody.appendChild(row);
    });

    toggleButtons();
    document.getElementById("requestModal").style.display = "flex";
  }

  function toggleButtons() {
    document.getElementById("approveBtn").style.display =
      selectedRequest.status === "pending" ? "inline-block" : "none";

    document.getElementById("rejectBtn").style.display =
      selectedRequest.status === "pending" ? "inline-block" : "none";

    document.getElementById("generateBtn").style.display =
      selectedRequest.status === "approved" ? "inline-block" : "none";
  }

  function closeModal() {
    document.getElementById("requestModal").style.display = "none";
  }
</script>

</body>

</html>