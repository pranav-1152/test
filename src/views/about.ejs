<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<style>

/* ================= BASE ================= */

html {
scroll-behavior: smooth;
}

body {
background:#eef2f6;
font-family: "Inter", sans-serif;
font-size:17px;
}

/* ================= ABOUT BACKGROUND ================= */

#about-section {
position: relative;
background: url("img1.jpg") center/cover no-repeat;
background-attachment: fixed;
}

/* Dark Blur Overlay */
#about-section::before {
content: "";
position: absolute;
inset: 0;
background: rgba(0,0,0,0.82);
backdrop-filter: blur(7px);
z-index: 0;
}

/* Content Above Overlay */
#about-section > div {
position: relative;
z-index: 2;
}

/* ================= HEADINGS ================= */

h1,h2,h3,h4 {
font-family: "Poppins", sans-serif;
}

#about-section h2 {
color:white;
font-size:42px;
font-weight:700;
text-shadow:0 3px 8px rgba(0,0,0,0.8);
}

#about-section h3 {
color:white;
font-size:30px;
margin-top:50px;
}

/* Description under title */
.about-desc {
max-width:900px;
margin:15px auto 50px;
color:#e2e2e2;
font-size:19px;
line-height:1.9;
text-align:center;
}

/* ================= CONTENT BLOCK STYLE ================= */

.about-card {
background: transparent;
padding: 25px 10px;
border-left: 6px solid #28a745;
margin-bottom:40px;
}

/* Heading inside block */
.about-card b {
color:#3cff8f;
font-size:20px;
font-weight:700;
display:block;
margin-bottom:8px;
}

/* Paragraph text */
.about-card p {
color:#dddddd;
font-size:18px;
line-height:1.8;
}

/* List items */
.about-card li {
color:#d6d6d6;
font-size:18px;
line-height:1.8;
}

/* ================= SCROLL ANIMATION ================= */

.scroll-left {
opacity:0;
transform:translateX(-120px);
transition:1s ease;
}

.scroll-right {
opacity:0;
transform:translateX(120px);
transition:1s ease;
}

.scroll-show {
opacity:1;
transform:translateX(0);
}

/* ================= TITLE LINE ================= */

.title-line {
position:relative;
display:inline-block;
}

.title-line::after {
content:'';
width:0;
height:4px;
background:#28a745;
position:absolute;
left:0;
bottom:-8px;
transition:0.4s;
}

.title-line:hover::after {
width:100%;
}

</style>

</head>

<body>

