<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>DPR Admin Dashboard</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
    }

    /* Top Bar */
    .topbar {
      background: #ffffff;
      height: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 30px;
      border-bottom: 1px solid #ddd;
    }

    .topbar .right {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    /* Layout */
    .container {
      display: flex;
    }

    /* Sidebar */
    .sidebar {
      width: 220px;
      background: #ffffff;
      min-height: calc(100vh - 60px);
      border-right: 1px solid #ddd;
      padding-top: 20px;
    }

    .sidebar a {
      display: block;
      padding: 12px 30px;
      color: #555;
      text-decoration: none;
      font-size: 14px;
    }

    .sidebar a:hover {
      background: #f0f0f0;
    }

    /* Main */
    .main {
      flex: 1;
      padding: 30px;
    }

    /* Stats Cards */
    .stats {
      display: flex;
      gap: 20px;
    }

    .stat {
      flex: 1;
      padding: 20px;
      border-radius: 12px;
      color: #333;
    }

    .stat h2 {
      margin: 0;
      font-size: 26px;
    }

    .stat p {
      margin: 5px 0 0;
    }

    .stat.total {
      background: #ffecec;
    }

    .stat.pending {
      background: #fff1d6;
    }

    .stat.approved {
      background: #e6fff3;
    }

    .stat.ai {
      background: linear-gradient(90deg, #1e90ff, #ffb400);
      color: #fff;
    }

    /* Content Grid */
    .grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      margin-top: 30px;
    }

    /* Cards */
    .card {
      background: #ffffff;
      border-radius: 12px;
      padding: 20px;
    }

    /* Chart Placeholder */
    .chart {
      height: 220px;
      background: repeating-linear-gradient(45deg,
          #f0f0f0,
          #f0f0f0 10px,
          #ffffff 10px,
          #ffffff 20px);
      border-radius: 10px;
    }

    /* Progress Circle */
    .circle {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: 14px solid #eee;
      border-top: 14px solid #1ed760;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: bold;
      margin: auto;
    }
  </style>
</head>

<body>

  <!-- Top Bar -->
  <div class="topbar">
    <strong>Admin Logo</strong>
    <div class="right">
      🔔 Admin
    </div>
  </div>

  <div class="container">

    <!-- Sidebar -->
    <div class="sidebar">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/requests">Requests</a>
      <a href="#">Pending DPR</a>
      <a href="#">Generated DPR</a>
      <a href="#">Rejected</a>
      <a href="#">Reports</a>
      <a href="#">Settings</a>
    </div>

    <!-- Main -->
    <div class="main">

      <!-- Stats -->
      <div class="stats">
        <div class="stat total">
          <h2>
            <%= stats.total %>
          </h2>
          <p>Total Requests</p>
        </div>

        <div class="stat pending">
          <h2>
            <%= stats.pending %>
          </h2>
          <p>Pending Review</p>
        </div>

        <div class="stat approved">
          <h2>
            <%= stats.approved %>
          </h2>
          <p>Approved</p>
        </div>

        <div class="stat ai">
          <h2>AI DPR</h2>
          <p>Generate DPR</p>
        </div>
      </div>

      <!-- Charts -->
      <div class="grid">

        <div class="card">
          <h3>Request Statistics (Last 6 Months)</h3>
          <div class="chart"></div>
        </div>

        <div class="card">
          <h3>DPR Completion</h3>
          <div class="circle" id="completionPercent">
            <%= stats.completion %>%
          </div>
          <p style="text-align:center;margin-top:15px;">
            🟢 Generated &nbsp;&nbsp;
            🔵 Approved &nbsp;&nbsp;
            🟡 Pending &nbsp;&nbsp;
            🔴 Rejected
          </p>
        </div>

      </div>

      <!-- Activity -->
      <div class="card" style="margin-top:20px;">
        <h3>Recent Activity</h3>

        <% activities.forEach(act=> { %>
          <p>
            <%= act %>
          </p>
          <% }) %>
      </div>

    </div>
  </div>
</body>

</html>